# Public URL of the deployed site (used for canonical URLs, sitemap.xml, robots.txt)
VITE_SITE_URL=https://www.your-domain.com

# Optional: endpoint that receives form submissions as JSON POST
# (e.g. a Formspree / Basin / Getform URL, or your own API).
# If empty, forms validate and show the confirmation screen but DO NOT send data anywhere.
VITE_FORM_ENDPOINT=
